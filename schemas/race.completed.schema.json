{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simcoaches.com/schemas/leaderboard/race.completed.schema.json",
  "title": "Sim Coaches Race Completed Event",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "session_id",
    "racer",
    "race_time_seconds",
    "formatted_race_time",
    "simulator_id",
    "completed_at"
  ],
  "properties": {
    "event_type": {
      "const": "race.completed"
    },
    "event_id": {
      "type": "string",
      "description": "Unique ID for this webhook event."
    },
    "session_id": {
      "type": "string",
      "description": "Stable race session ID from the sim registration flow when available."
    },
    "racer": {
      "type": "object",
      "required": ["first_name", "last_name", "full_name", "email", "phone"],
      "properties": {
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "full_name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "additionalProperties": false
    },
    "race_time_seconds": {
      "type": "number"
    },
    "formatted_race_time": {
      "type": "string",
      "examples": ["01:23.456"]
    },
    "simulator_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "demo_url": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
