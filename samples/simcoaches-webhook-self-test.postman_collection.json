{
  "info": {
    "name": "Sim Coaches Webhook Self-Test",
    "description": "Send a signed race.completed sample webhook to a partner staging endpoint. This does not require the Sim Coaches Receiver app source or runtime.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "webhook_url",
      "value": "https://partner.example.com/webhooks/simcoaches/race-completed"
    },
    {
      "key": "api_key",
      "value": "replace-with-shared-api-key"
    },
    {
      "key": "signing_secret",
      "value": "replace-with-shared-signing-secret"
    }
  ],
  "item": [
    {
      "name": "Send signed race.completed sample",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const payload = {",
              "  completed_at: new Date().toISOString(),",
              "  demo_url: 'https://partner.example.com/demo',",
              "  event_id: pm.variables.replaceIn('{{$guid}}'),",
              "  event_type: 'race.completed',",
              "  formatted_race_time: '01:23.456',",
              "  race_time_seconds: 83.456,",
              "  racer: {",
              "    email: 'alex@example.com',",
              "    first_name: 'Alex',",
              "    full_name: 'Alex Racer',",
              "    last_name: 'Racer',",
              "    phone: '+17025550123'",
              "  },",
              "  session_id: 'self-test-' + pm.variables.replaceIn('{{$guid}}'),",
              "  simulator_id: '1'",
              "};",
              "",
              "const body = JSON.stringify(payload);",
              "const signingSecret = pm.collectionVariables.get('signing_secret') || '';",
              "const apiKey = pm.collectionVariables.get('api_key') || '';",
              "const signature = CryptoJS.HmacSHA256(body, signingSecret).toString(CryptoJS.enc.Hex);",
              "",
              "pm.request.body.update(body);",
              "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
              "pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${apiKey}` });",
              "pm.request.headers.upsert({ key: 'X-SimCoaches-Signature', value: signature });",
              "pm.request.headers.upsert({ key: 'User-Agent', value: 'SimCoaches-Leaderboard-Receiver' });",
              "console.log('event_id', payload.event_id);",
              "console.log('signature', signature);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{webhook_url}}",
          "host": [
            "{{webhook_url}}"
          ]
        }
      }
    }
  ]
}
